# PostgreSQL
# DATABASE_URL se usa al ejecutar el CRUD desde el host.
DATABASE_URL=
# Compose construye DATABASE_URL para el CRUD con postgres:5432.
# Usa caracteres sin escape de URL para estos tres valores y genera una contraseña local.
POSTGRES_DB=reservas
POSTGRES_USER=reservas
POSTGRES_PASSWORD=

# Aplicaciones
# Puertos del host para Compose y puertos de escucha al ejecutar con npm.
CRUD_PORT=3001
MID_PORT=3002

# Gateway
# Usa el origen accesible desde quien ejecute el MID. Consulta el README para Docker.
GATEWAY_URL=
GATEWAY_CLIENT_ID=
GATEWAY_CLIENT_SECRET=
# Contrato provisional de Client Credentials. Formatos admitidos: form o json.
GATEWAY_TOKEN_PATH=/token
GATEWAY_TOKEN_FORMAT=form
# Plazo por intento en milisegundos y reintentos adicionales para lecturas (0 a 3).
GATEWAY_TIMEOUT_MS=3000
GATEWAY_READ_RETRIES=1
# Secreto compartido para la cabecera provisional x-gateway-secret.
# Configurarlo en ambos servicios. Dejar vacío únicamente en este ejemplo.
GATEWAY_INTERNAL_SECRET=

# API externa
OPEN_METEO_BASE_URL=https://api.open-meteo.com
OPEN_METEO_TIMEOUT_MS=3000
OPEN_METEO_MAX_RETRIES=1
OPEN_METEO_CACHE_TTL_SECONDS=900
OPEN_METEO_CACHE_MAX_ENTRIES=500
