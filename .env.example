# PostgreSQL
DATABASE_URL=

# Aplicaciones
CRUD_PORT=3001
MID_PORT=3002

# Gateway
GATEWAY_URL=
GATEWAY_CLIENT_ID=
GATEWAY_CLIENT_SECRET=
# Contrato provisional de Client Credentials. Formatos admitidos: form o json.
GATEWAY_TOKEN_PATH=/token
GATEWAY_TOKEN_FORMAT=form
# Plazo por intento en milisegundos y reintentos adicionales para lecturas (0 a 3).
GATEWAY_TIMEOUT_MS=3000
GATEWAY_READ_RETRIES=1
# Secreto compartido para la cabecera provisional x-gateway-secret.
# Configurarlo en ambos servicios. Dejar vacío únicamente en este ejemplo.
GATEWAY_INTERNAL_SECRET=

# API externa
OPEN_METEO_BASE_URL=https://api.open-meteo.com
